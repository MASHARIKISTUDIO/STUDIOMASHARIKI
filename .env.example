# ---------------------------------------------------------------------------
# Studio Mashariki - environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Absolute public origin, used for metadataBase, canonical URLs, sitemap and
# robots. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://studiomashariki.com

# WhatsApp destination for session bookings (digits, country code, no +).
# Kenya example: 2547XXXXXXXX. The admin calendar can also set this in
# Convex (Dashboard → Session hours); that value wins when both are present.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Clerk (authentication) ------------------------------------------------
# Placeholders ONLY. `.gitignore` un-ignores this file (`!.env.example`), so
# anything pasted here is committed - real keys belong in `.env` / `.env.local`.
# Clerk publishable key. Not NEXT_PUBLIC_*: the root layout passes it into
# ClerkProvider. Copy this name into Vercel as CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret of the Clerk webhook endpoint that points at
#   https://<your-deployment>.convex.site/clerk-webhook
# subscribed to user.created, user.updated, user.deleted.
# Must ALSO be set on the Convex deployment, since the handler runs there:
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bootstrap admin allowlist. Comma-separated emails that are granted the `admin`
# role automatically on sign-up, so the first admin can exist before any admin
# UI does. Leave blank once real admins are assigned in the Clerk dashboard.
#   npx convex env set CLERK_ADMIN_EMAILS you@example.com
CLERK_ADMIN_EMAILS=

# Points Clerk at the app's own auth pages instead of its hosted Account Portal.
# Without these, `auth.protect()` in `proxy.ts` bounces signed-out visitors to
# https://<your-app>.accounts.dev and they never see the branded login page.
# Both routes are optional catch-alls (`app/(auth)/sign-in/[[...rest]]`), which
# is what lets Clerk append its own sub-steps under them.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land when someone opens /sign-in directly, with no `redirect_url` in
# the query string. When they were bounced off a protected page, Clerk returns
# them there instead and these are ignored.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# The Clerk JWT template named "convex" issues the tokens Convex validates.
# Create it in Clerk Dashboard -> JWT Templates -> New template -> Convex.
# This is the "Issuer" URL of that template, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# --- Convex (database + backend) -------------------------------------------
# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name
# Public URL of the Convex deployment, consumed by the browser client.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# --- Media pipeline switch -------------------------------------------------
# Selects where uploads go and how video is played back.
#   s3         -> presigned POST to S3, playback via native <video>
#   cloudflare -> Cloudflare Stream direct creator upload, playback via HLS
# Must also be set on the Convex deployment:
#   npx convex env set VIDEO_PROCESSING_PROVIDER s3
VIDEO_PROCESSING_PROVIDER=s3

# --- AWS S3 (used when VIDEO_PROCESSING_PROVIDER=s3) -----------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=studiomashariki-media
# Optional: public read origin for the bucket (CloudFront or S3 website URL).
# Falls back to https://$AWS_S3_BUCKET.s3.$AWS_REGION.amazonaws.com
AWS_S3_PUBLIC_URL=

# Optional: S3-compatible providers (Cloudflare R2, MinIO, DigitalOcean Spaces)
# Leave blank for real AWS S3.
AWS_S3_ENDPOINT=
# Set to true for MinIO / most S3-compatible providers.
AWS_S3_FORCE_PATH_STYLE=false

# --- Cloudflare Stream (used when VIDEO_PROCESSING_PROVIDER=cloudflare) ----
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API token with the "Stream:Edit" permission.
CLOUDFLARE_STREAM_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional custom customer subdomain for playback URLs, e.g.
# customer-xxxxxxxx.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
